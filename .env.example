# ASC single-owner access boundary
# Keep both values server-side. Never expose them through NEXT_PUBLIC_* variables.
ASC_OWNER_PASSWORD=
ASC_SESSION_SECRET=

# Development Intelligence service boundary
DEVINT_URL=https://devint.cardforges.com
DEVINT_TOKEN=

# Default project shown by the owner shell
ASC_DEFAULT_REPOSITORY=pyralisxc/AI-Systems-Control

# Optional desired-state overlay for repository.default_ref
ASC_DESIRED_DEFAULT_REF=main

# Observation freshness thresholds
ASC_FRESHNESS_WARNING_SECONDS=300
ASC_FRESHNESS_STALE_SECONDS=1800

# Durable ASC control registry.
# Hosted default: standard DATABASE_URL supplied by your Postgres provider/integration.
# ASC_CONTROL_REGISTRY_DATABASE_URL is an explicit override when ASC should use a different database.
# Compatible with Neon, Supabase Postgres, ordinary hosted PostgreSQL, or self-hosted PostgreSQL.
DATABASE_URL=
ASC_CONTROL_REGISTRY_DATABASE_URL=

# Local/self-hosted single-server alternative. Must point to a persistent volume.
# Do not use ephemeral serverless filesystem storage.
ASC_CONTROL_REGISTRY_PATH=

# Personal mode uses one default tenant. Multi-user clients will select this from Membership context.
ASC_DEFAULT_ACCOUNT_DOMAIN_ID=domain:personal

# Personal-mode bootstrap. These seed one human Principal + owner Membership.
# Enterprise/federated identity providers will map authenticated identities to Principals instead.
ASC_BOOTSTRAP_PRINCIPAL_ID=principal:owner
ASC_BOOTSTRAP_PRINCIPAL_NAME=Owner
ASC_DEFAULT_ACCOUNT_DOMAIN_NAME=Personal

# Disable this when a federated/multi-user authentication layer supplies Principal/Membership context.
ASC_PERSONAL_BOOTSTRAP_ENABLED=true


# Authenticated ChatGPT/Codex MCP resource server.
# ASC is the resource server; use an established external OAuth/OIDC authorization server.
ASC_MCP_RESOURCE_URL=https://asc.example.com/mcp
ASC_OAUTH_ISSUER=https://auth.example.com
ASC_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
ASC_MCP_ACCOUNT_DOMAIN_CLAIM=asc_account_domain_id
ASC_MCP_SCOPE_CLAIM=scope
ASC_MCP_DOCUMENTATION_URL=https://asc.example.com/docs/mcp

# Advanced compatibility: explicit personal/bootstrap federated identity mapping.
# Normal setup should use owner-approved identity pairing in /setup/mcp instead of copying a subject identifier.
# If used, both values must be configured together.
ASC_BOOTSTRAP_AUTH_ISSUER=
ASC_BOOTSTRAP_AUTH_SUBJECT=

# Optional comma-separated extra hostnames/absolute origins for non-production development routes.
# Requests without an Origin header are unaffected.
ASC_MCP_ALLOWED_HOSTS=
ASC_MCP_ALLOWED_ORIGINS=


# Founder Relay calibration policy. These thresholds only surface an owner-review candidate.
# They never create or modify an AutonomyGrant automatically.
ASC_RELAY_CALIBRATION_MIN_RESPONSES=20
ASC_RELAY_CALIBRATION_MIN_ACCEPTANCE_RATE=0.9
ASC_RELAY_CALIBRATION_MAX_REJECTION_RATE=0.05
ASC_RELAY_CALIBRATION_MAX_MEAN_EDIT_RATIO=0.25
