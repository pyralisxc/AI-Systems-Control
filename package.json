{
  "name": "ai-systems-control",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:core": "npm run clean && tsc -p tsconfig.core.json",
    "build:web": "npm run build:core && next build",
    "build": "npm run build:web",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:web": "npm run build:core && next typegen && tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:web",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build:core && node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run typecheck:web && node --test tests/*.test.mjs && next build",
    "dev": "next dev",
    "start": "next start",
    "slice-a": "npm run build:core && node scripts/slice-a-owner.mjs"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5.8.3"
  }
}
